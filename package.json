{
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "eslint": "eslint src/ --fix",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,html,css,md}\"",
    "stylelint": "stylelint \"src/**/*.css\" --fix",
    "lint": "npm run stylelint && npm run eslint && npm run prettier",
    "prepare": "husky",
    "commit": "cz",
    "test": "vitest"
  },
  "lint-staged": {
    "./src/**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "./src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,html,md}": "prettier --write"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "sass": "^1.108.0",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-readable-classnames": "^1.5.3",
    "vite-plugin-sass-dts": "^1.3.31",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
